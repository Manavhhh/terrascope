# TERRA//SCOPE Environment Configuration Template
# Duplicate this file to .env for local development

# -------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# -------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# -------------------------------------------------------------
# 2. SATELLITE DATA PROVIDER CREDENTIALS (OPTIONAL)
# -------------------------------------------------------------
# NASA Earthdata Login (EDL) - Required only for direct download of restricted products.
# Public search via Alaska Satellite Facility (ASF) works out of the box without credentials!
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_BEARER_TOKEN=

# ISRO Bhoonidhi S-band NISAR API credentials (Optional)
ISRO_BHOONIDHI_API_KEY=
ISRO_BHOONIDHI_TOKEN=

# -------------------------------------------------------------
# 3. 3D VISUALIZATION CREDENTIALS (OPTIONAL)
# -------------------------------------------------------------
# Cesium Ion Access Token (Optional)
# If left empty, TERRA//SCOPE automatically cascades to high-performance open satellite basemaps (CartoDB Dark Matter / OSM / NASA GIBS)
VITE_CESIUM_ION_TOKEN=

# -------------------------------------------------------------
# 4. ORBIT AI INTELLIGENCE ASSISTANT (OPTIONAL)
# -------------------------------------------------------------
# Optional external LLM API keys for ORBIT conversational interface.
# If not configured, ORBIT uses its built-in deterministic radar science rule engine.
OPENAI_API_KEY=
GEMINI_API_KEY=
